[user]
	name = Alex Landovskis
	email = 61091411+alandovskis@users.noreply.github.com
[core]
	autocrlf = input
	editor = vim
    pager = delta
	whitespace = trailing-space,space-before-tab
[alias]
	amend = commit --amend
	br = branch
	ci = commit
	co = checkout
	df = diff
	detach = !sh -c 'git checkout $(git rev-parse ${1:-HEAD})' --
	last = log -1 HEAD
	lol = log --pretty=oneline --abbrev-commit --graph --decorate
	lola = log --pretty=oneline --abbrev-commit --graph --decorate --all
	remotes = remote -v
	root = rev-parse --show-toplevel
	sha1 = !sh -c 'git rev-parse --short ${1:-HEAD}' --
	st = status
	unstage = rm --cached
[color]
	ui = true
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
[merge]
    conflictstyle = diff3
[diff]
	colorMoved = default
	algorithm = histogram
[init]
	defaultBranch = main
[pull]
	rebase = true
[rerere]
	enabled = true
[rebase]
	autosquash = true
[branch]
	sort = -committerdate
[fetch]
	prune = true
